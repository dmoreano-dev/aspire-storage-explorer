<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Aspire.Hosting</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>StorageExplorer.Aspire.Hosting</PackageId>
    <Version>0.6.0</Version>
    <Description>Aspire hosting integration that adds a web-based Azure Storage explorer (blobs, queues and tables) to the AppHost.</Description>
    <PackageTags>aspire integration hosting azure storage blob queue table explorer azurite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Daniel Moreano</Authors>
    <Copyright>Copyright (c) 2026 Daniel Moreano</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- The repository URL comes from the git remote; the release workflow also sets PackageProjectUrl. -->
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.1.0" />
    <!--
      Direct override, not a stray reference: 13.1.0 pulls MessagePack 2.5.192 through StreamJsonRpc, which trips
      NU1902/NU1903. Raising Aspire.Hosting.Azure.Storage instead (13.2.0+) fixes that but hangs
      DistributedApplication.CreateBuilder().Build() forever on dispose when the app is never Run() - the pattern
      WithStorageExplorerTests uses. See CHANGELOG.md [Unreleased] before touching either version.
    -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
